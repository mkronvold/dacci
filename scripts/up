#!/usr/bin/env bash

set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
repo_root="$(CDPATH= cd -- "${script_dir}/.." >/dev/null && pwd)"

find_default_content_repo_root() {
  local workspace_root="${1}"
  local candidate

  if [[ -d "${workspace_root}/E2Open.KPE.Content/.git" && -d "${workspace_root}/E2Open.KPE.Content/data" ]]; then
    printf '%s\n' "${workspace_root}/E2Open.KPE.Content"
    return 0
  fi

  while IFS= read -r -d '' candidate; do
    if [[ -e "${candidate}/.git" && -d "${candidate}/data" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done < <(find "${workspace_root}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0 | sort -z)

  return 0
}

stage_host_ssh_dir() {
  local source_dir="${1}"
  local repo_hash staged_root staged_dir

  repo_hash="$(printf '%s' "${repo_root}" | sha1sum | cut -d' ' -f1)"
  staged_root="${XDG_RUNTIME_DIR:-/tmp}/dacci-runtime"
  staged_dir="${staged_root}/ssh-${repo_hash}"

  mkdir -p -- "${staged_root}"
  rm -rf -- "${staged_dir}"
  mkdir -p -- "${staged_dir}"

  if ! cp -aL "${source_dir}/." "${staged_dir}/"; then
    printf 'scripts/up: failed to stage DACCI_HOST_SSH_DIR into a container-safe directory (check for unreadable files or broken symlinks under %s)\n' "${source_dir}" >&2
    exit 1
  fi

  chmod 700 -- "${staged_dir}"
  printf '%s\n' "${staged_dir}"
}

default_workspace_root="${repo_root}/workspace"
mkdir -p -- "${default_workspace_root}"

library_workspace_root="${DACCI_LIBRARY_WORKSPACE_ROOT:-${default_workspace_root}}"
mkdir -p -- "${library_workspace_root}"
content_root="${DACCI_CONTENT_ROOT:-${DACCI_WORKSPACE_ROOT:-}}"
if [[ -z "${content_root}" ]]; then
  content_root="$(find_default_content_repo_root "${library_workspace_root}")"
fi

has_runtime_repo=0
if [[ -n "${content_root}" ]]; then
  if [[ ! -e "${content_root}/.git" || ! -d "${content_root}/data" ]]; then
    printf 'scripts/up: DACCI_CONTENT_ROOT must point at a Git-backed content repo with a data/ directory\n' >&2
    exit 1
  fi
  has_runtime_repo=1
else
  content_root="${library_workspace_root}/.dacci-empty-content"
  mkdir -p -- "${content_root}/data"
fi

if [[ ! -d "${library_workspace_root}" ]]; then
  printf 'scripts/up: DACCI_LIBRARY_WORKSPACE_ROOT must point at an existing directory\n' >&2
  exit 1
fi

host_ssh_dir="${DACCI_HOST_SSH_DIR:-${HOME}/.ssh}"
if [[ ! -d "${host_ssh_dir}" ]]; then
  printf 'scripts/up: DACCI_HOST_SSH_DIR must point at an existing SSH directory (default: %s)\n' "${HOME}/.ssh" >&2
  exit 1
fi
container_ssh_dir="$(stage_host_ssh_dir "${host_ssh_dir}")"

if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
  if [[ ! -S "${SSH_AUTH_SOCK}" ]]; then
    printf 'scripts/up: SSH_AUTH_SOCK is set but does not point at a live agent socket\n' >&2
    exit 1
  fi

  ssh_auth_sock="${SSH_AUTH_SOCK}"
  ssh_auth_sock_dir="$(dirname -- "${SSH_AUTH_SOCK}")"
else
  ssh_auth_sock=""
  ssh_auth_sock_dir="${XDG_RUNTIME_DIR:-/tmp}/dacci-empty-ssh-agent"
  mkdir -p -- "${ssh_auth_sock_dir}"
fi

content_repo_name="$(basename -- "${content_root}")"
runtime_repo_root=""
runtime_data_root=""
if [[ "${has_runtime_repo}" -eq 1 ]]; then
  runtime_repo_root="/workspace/${content_repo_name}"
  runtime_data_root="${runtime_repo_root}/data"
fi
if [[ "${content_root}" != "${library_workspace_root}" && "${content_root}" != "${library_workspace_root}/"* ]]; then
  printf 'scripts/up: DACCI_CONTENT_ROOT must be located inside DACCI_LIBRARY_WORKSPACE_ROOT so repos mount under /workspace/<repo-name>\n' >&2
  exit 1
fi

compose_env=(
  "DACCI_CONTENT_ROOT=${content_root}"
  "DACCI_CONTENT_REPO_NAME=${content_repo_name}"
  "DACCI_LIBRARY_WORKSPACE_ROOT=${library_workspace_root}"
  "DACCI_RUNTIME_DATA_ROOT=${runtime_data_root}"
  "DACCI_RUNTIME_GIT_SYNC_REPO_ROOT=${runtime_repo_root}"
  "DACCI_HOST_SSH_DIR=${container_ssh_dir}"
  "DACCI_SSH_AUTH_SOCK=${ssh_auth_sock}"
  "DACCI_SSH_AUTH_SOCK_DIR=${ssh_auth_sock_dir}"
)

env "${compose_env[@]}" docker compose -f "${repo_root}/deploy/docker/compose.yaml" up --build -d
